<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/category_quicksettings_title" >

    <com.android.settingslib.widget.IllustrationPreference
        android:key="lottie_row_quick_setting_style"
        lineage:lottie_rawRes="@raw/lottie_row_quick_setting_style" />

    <!-- QS Header -->
    <Preference
            android:key="qs_header_image"
            android:title="@string/qs_header_image_title"
            android:summary="@string/qs_header_image_summary"
            android:fragment="com.horizon.fragments.quicksettings.QsHeaderImageSettings" />

    <!-- QS Media Player  -->
    <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="qs_compact_media_player_mode"
            android:title="@string/qs_compact_media_player_mode_title"
            android:summary="@string/qs_compact_media_player_mode_summary"
            android:defaultValue="false"  />

   <com.android.settings.custom.preference.SecureSettingSwitchPreference
            android:key="media_controls_always_show_time"
            android:title="@string/media_controls_always_show_time_title"
            android:summary="@string/media_controls_always_show_time_summary"
            android:defaultValue="false" />
        
    <!-- Show Media Squiggle Animation  -->
    <com.android.settings.custom.preference.SecureSettingSwitchPreference
            android:key="show_media_squiggle_animation"
            android:title="@string/show_squiggle_animation_title"
            android:summary="@string/show_squiggle_animation_summary"
            android:defaultValue="false" />

    <!-- QS Data Use  -->        
    <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="qs_show_data_usage"
            android:title="@string/qs_footer_datausage_title"
            android:summary="@string/qs_footer_datausage_summary" />

    <!-- QS Bringhtness Percentage  -->
    <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:title="Brightness Percentage"
            android:key="BRIGHTNESS_TEXTVIEW"
            android:summary="show hide brightness percentage text"
            android:defaultValue="false" />

</PreferenceScreen>
