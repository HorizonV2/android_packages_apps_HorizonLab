<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:title="@string/category_misc_title" >

    <com.android.settingslib.widget.IllustrationPreference
        android:key="misc_illustration"
        lineage:lottie_rawRes="@raw/misc_illustration" />

    <!-- GameSpace -->
    <Preference
        android:key="game_space"
        android:title="@string/game_space_title"
        android:summary="@string/game_space_summary">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="io.chaldeaprjkt.gamespace"
            android:targetClass="io.chaldeaprjkt.gamespace.settings.SettingsActivity" />
    </Preference>

    <Preference
            android:key="button_settings"
            android:title="@string/button_pref_title"
            android:summary="@string/button_pref_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="org.lineageos.lineageparts"
                android:targetClass="org.lineageos.lineageparts.input.ButtonSettings" />
     </Preference>

     <Preference
            android:key="gesture_settings"
            android:title="@string/gesture_preference_title"
            android:summary="@string/gesture_preference_summary"
            android:fragment="com.android.settings.gestures.GestureSettings"
            settings:controller="com.android.settings.gestures.GesturesSettingPreferenceController"/>

   <com.android.settings.custom.preference.SystemSettingSwitchPreference
        android:key="arcane_idle_manager"
        android:title="@string/idle_manager_title"
        android:summary="@string/idle_manager_summary"
        android:defaultValue="false" />

   <com.android.settings.custom.preference.SystemPropertySwitchPreference
        android:key="persist.sys.pixelprops.games"
        android:title="@string/games_spoof_title"
        android:summary="@string/games_spoof_summary"
        android:defaultValue="true" />  

    <com.android.settings.custom.preference.GlobalSettingSwitchPreference
        android:key="pm_downgrade_allowed"
        android:title="@string/app_downgrade_title"
        android:summary="@string/app_downgrade_summary"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.GlobalSettingSwitchPreference
        android:key="window_ignore_secure"
        android:title="@string/ignore_window_secure_title"
        android:summary="@string/ignore_window_secure_summary"
        android:defaultValue="true"/>

    <!-- Netflix -->
    <com.android.settings.custom.preference.SystemPropertySwitchPreference
        android:key="persist.sys.pixelprops.netflix"
        android:title="@string/netflix_spoof_title"
        android:summary="@string/netflix_spoof_summary"
        android:defaultValue="true" />

    <com.android.settings.custom.preference.SystemPropertySwitchPreference
        android:key="persist.sys.pixelprops.gphotos"
        android:title="@string/photos_spoof_title"
        android:summary="@string/photos_spoof_summary"
        android:defaultValue="true" />

    <com.android.settings.custom.preference.SecureSettingSwitchPreference
        android:key="spoof_storage_encryption_status"
        android:title="@string/spoof_storage_encryption_status_title"
        android:summary="@string/spoof_storage_encryption_status_summary"
        android:defaultValue="false"/> 

    <com.android.settings.custom.preference.SecureSettingSwitchPreference
        android:key="show_clipboard_overlay"
        android:title="@string/show_clipboard_overlay_title"
        android:summary="@string/show_clipboard_overlay_summary"
        android:defaultValue="true" /> 

     <com.android.settings.custom.preference.SystemSettingSwitchPreference
        android:key="unlimit_screenrecord"
        android:title="@string/miscellaneous_unlimit_screenrecord_title"
        android:summary="@string/miscellaneous_unlimit_screenrecord_summary"
        android:defaultValue="false" />

</PreferenceScreen>
